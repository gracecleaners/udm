# Copy to `.env` at the repository root and fill in real values. Never commit `.env`.

# --- Core -------------------------------------------------------------------
# Generate: python -c "import secrets;print(secrets.token_urlsafe(50))"
UDM_SECRET_KEY=
UDM_DEBUG=true
UDM_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
UDM_LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---------------------------------------------------
UDM_DB_NAME=udm
UDM_DB_USER=udm
UDM_DB_PASSWORD=
UDM_DB_HOST=127.0.0.1
UDM_DB_PORT=5432
UDM_DB_CONN_MAX_AGE=60

# --- Authentication ----------------------------------------------------------
UDM_JWT_ACCESS_MINUTES=30
UDM_JWT_REFRESH_DAYS=14

# --- Rate limiting -----------------------------------------------------------
UDM_THROTTLE_CONTENT=120/min
UDM_THROTTLE_AUTH=10/min

# --- Browser origins (admin/dashboard only; the mobile app ignores CORS) -----
UDM_CORS_ALLOWED_ORIGINS=
UDM_CORS_ALLOW_ALL_ORIGINS=true

# --- Media -------------------------------------------------------------------
# In production point this at a mounted volume or use object storage directly.
UDM_MEDIA_ROOT=

# --- Email (verification and password reset) ---------------------------------
UDM_EMAIL_HOST=
UDM_EMAIL_PORT=587
UDM_EMAIL_USE_TLS=true
UDM_EMAIL_HOST_USER=
UDM_EMAIL_HOST_PASSWORD=

# --- Content licensing -------------------------------------------------------
# Register the app in the YouVersion Platform Portal and accept translation
# licenses before setting the server-side key. Never put this key in Flutter.
YVP_APP_KEY=
# Comma-separated codes of public-domain or licensed translations allowed for
# memory verses that store their own text. Do not add a code unless the license
# permits redistribution.
UDM_MEMORY_VERSE_TRANSLATIONS=kjv,web,asv

# --- Passage router (GET /api/v1/bible/passage/) -----------------------------
# Every value here is optional. With nothing set, the router serves KJV/WEB/ASV
# from bible-api.com and answers a request for a licensed version with
# public-domain text plus an authorized deep link — it never fails on a key.
UDM_BIBLE_DEFAULT_TRANSLATION=kjv
# Refuses an explicitly requested verse span wider than this (a whole chapter
# is always allowed; the longest is Psalm 119 at 176 verses).
UDM_BIBLE_MAX_VERSES=200
# Free after registration at https://www.esv.org/services/, 5,000 requests/day.
# The router stops calling ESV once that count is reached for the UTC day.
ESV_API_KEY=
UDM_ESV_DAILY_QUOTA=5000
# api.nlt.to's documented text endpoint returned 404 when last verified
# (2026-11-11), so this route only works against an endpoint you can confirm.
NLT_API_KEY=
UDM_NLT_API_URL=https://api.nlt.to/api/text
# Map a code to a bolls.life abbreviation ONLY where the ministry holds text
# redistribution rights, e.g. UDM_BOLLS_TRANSLATIONS=nkjv:NKJV,csb:CSB17.
# Bibles are scraped there and Biblica blocks the NIV outright; leaving this
# empty keeps those versions deep-link-only, which is the compliant default.
UDM_BOLLS_TRANSLATIONS=
# Numeric bible.com ids from this app's own YouVersion licence, e.g. asv:12,web:206.
# They add a second authorized link; ids are never guessed.
UDM_BIBLE_YOUVERSION_IDS=

# Optional dynamic English-to-French translation for admin-authored content.
# Create a restricted Google Cloud Translation API key; never add it to Flutter.
UDM_TRANSLATION_API_KEY=

# --- Production-only ---------------------------------------------------------
# UDM_CSRF_TRUSTED_ORIGINS=https://udm.example.org
# UDM_SECURE_SSL_REDIRECT=true
# UDM_HSTS_SECONDS=31536000
