<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application android:usesCleartextTraffic="true">
        <!-- Merged into the debug build only: `flutter run --dart-define=UDM_API_BASE_URL=http://192.168.x.x:8000/api/v1`
             points the app at a Django server on the LAN, which is plain HTTP.
             Release builds keep Android's HTTPS default. -->
    </application>
</manifest>
